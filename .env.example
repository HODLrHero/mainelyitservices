# Copy to .env and fill in. Never commit .env.

# ── Resend (contact form — only needed for local contact form testing) ──
# Production uses Vercel env vars; leave blank if already set on Vercel.
RESEND_API_KEY=your_resend_api_key

# ── Stripe (required for agent invoice generation) ──
# Dashboard: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key

# Optional — not needed for creating/sending invoices
STRIPE_WEBHOOK_SECRET=

# ── Invoice defaults ──
STRIPE_DEFAULT_CURRENCY=usd
BUSINESS_NAME=Mainely I.T. Services LLC
BUSINESS_EMAIL=mainelyit@tuta.com

# Optional — only if using POST /api/create-invoice on the live site
INVOICE_API_SECRET=
