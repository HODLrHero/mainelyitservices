# Copy this file to .env and fill in your values.
# Never commit .env — it is gitignored.

# ── Resend (contact form — already used in production) ──
RESEND_API_KEY=your_resend_api_key

# ── Stripe (invoices & payments) ──
# Dashboard: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key

# Webhook signing secret (optional until you add /api/stripe-webhook)
# Dashboard: Developers → Webhooks
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret

# ── Invoice defaults ──
STRIPE_DEFAULT_CURRENCY=usd
BUSINESS_NAME=Mainely I.T. Services LLC
BUSINESS_EMAIL=mainelyit@tuta.com

# Secret token required to call POST /api/create-invoice
# Generate any long random string and keep it private.
INVOICE_API_SECRET=your_invoice_api_secret
